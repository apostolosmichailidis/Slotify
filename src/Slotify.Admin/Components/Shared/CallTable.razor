@if (Rows.Count == 0)
{
    <p class="empty">@EmptyText</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Ώρα</th>
                    @if (ShowClinic)
                    {
                        <th>Ιατρείο</th>
                    }
                    <th>Από</th>
                    <th>Διάρκεια</th>
                    <th>Αποτέλεσμα</th>
                    <th class="wide">Περίληψη</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Rows)
                {
                    <tr class="clickable" @onclick="@(() => Nav.NavigateTo($"calls/{c.Id}"))">
                        <td class="nowrap"><a href="calls/@c.Id">@Display.DateTime(c.StartedAt)</a></td>
                        @if (ShowClinic)
                        {
                            <td>@c.ClinicName</td>
                        }
                        <td class="nowrap mono">@(c.FromNumber ?? "απόκρυψη")</td>
                        <td class="nowrap">@Display.Duration(c.DurationSeconds)</td>
                        <td><OutcomeBadge Outcome="c.Outcome" /></td>
                        <td class="wide"><div class="clamp">@c.Summary</div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<CallRow> Rows { get; set; } = [];

    [Parameter]
    public bool ShowClinic { get; set; } = true;

    [Parameter]
    public string EmptyText { get; set; } = "Καμία κλήση.";
}
