@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark">S</span> Slotify</a>
        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All">Αρχική</NavLink>
            <NavLink href="clinics">Ιατρεία</NavLink>
            <NavLink href="calls">Κλήσεις</NavLink>
        </nav>
        <div class="sidebar-foot">
            <AuthorizeView>
                <span class="muted small">@context.User.Identity?.Name</span>
            </AuthorizeView>
            <form method="post" action="account/logout" data-enhance="false">
                <AntiforgeryToken />
                <button class="link-btn" type="submit">Αποσύνδεση</button>
            </form>
        </div>
    </aside>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Κάτι πήγε στραβά.
    <a href="." class="reload">Ανανέωση</a>
    <span class="dismiss">🗙</span>
</div>
