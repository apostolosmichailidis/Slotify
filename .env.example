# Αντίγραψέ το σε .env και συμπλήρωσε. Το .env ΔΕΝ ανεβαίνει στο Git.

# Η δημόσια διεύθυνση που βλέπει το Twilio (π.χ. από ngrok). Στην παραγωγή βγαίνει από το VOICE_DOMAIN.
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# Μόνο για παραγωγή (docker-compose.prod.yml): τα domains που δείχνουν στον server.
VOICE_DOMAIN=voice.example.gr
ADMIN_DOMAIN=admin.example.gr
# Πόσες μέρες κρατάμε backup της βάσης.
BACKUP_KEEP_DAYS=14

# Twilio Console → Account Info → Auth Token
TWILIO_AUTH_TOKEN=

# Ένα μεγάλο τυχαίο κείμενο, π.χ. από: openssl rand -base64 32
STREAM_SECRET=

POSTGRES_PASSWORD=slotify

# Διαχειριστικό (http://localhost:8001). Κωδικός τουλάχιστον 12 χαρακτήρων.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Assistant = η κανονική γραμματεία, Echo = ακούς τη φωνή σου πίσω (πρώτη δοκιμή), Silent = μόνο logs
VOICE_MODE=Echo

# Χρειάζονται μόνο για VOICE_MODE=Assistant
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ANTHROPIC_API_KEY=

# Προαιρετικά: Google Calendar για να κλείνει ραντεβού κατευθείαν (δες README).
# Όλο το JSON του service account σε μία γραμμή, μέσα σε μονά εισαγωγικά.
GOOGLE_SERVICE_ACCOUNT_JSON=
DEMO_CLINIC_CALENDAR_ID=

# Για Development: φτιάχνει δοκιμαστικό ιατρείο σε αυτόν τον αριθμό Twilio
ASPNETCORE_ENVIRONMENT=Development
DEMO_CLINIC_PHONE_NUMBER=+30xxxxxxxxxx
